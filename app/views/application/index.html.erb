<div class='filter'></div>
<div class='main-wrapper'>

<ul class='navigation-menu'>
  <li>TOM TRAGO</br></br></li>
  <% @pages.each do |p| %>
  <li data-section-name='<%= p.href %>' class='<%= p.href %>'><%= link_to p.title.upcase, p.link || "##{p.href}", target: "_blank" && p.link.present? || '_self' %></li>
  <% end %>
</ul>
<div class='main-content'>
  <% @pages.where.not(content: nil).each do |p| %>
  <section data-section-name='<%= p.href %>'>

  <%= p.content.html_safe %>
  </section>
  <% end %>
</div>
</div>
