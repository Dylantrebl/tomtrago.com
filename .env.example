# Copy to .env for local development. For Heroku, set these as Config Vars.
# Generated from config/secrets.yml, config/database.yml, config/cable.yml,
# config/environments/production.rb, config/puma.rb

# === Required for production (Heroku) ===
# Generate with: bundle exec rails secret
SECRET_KEY_BASE=

# Heroku sets this when you add Heroku Postgres. Locally, use your DB URL.
DATABASE_URL=

# === Recommended for Heroku ===
RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=1
RAILS_LOG_TO_STDOUT=1

# === Optional ===
# Set by Heroku when you add Heroku Redis (for ActionCable). Has build-time default.
REDIS_URL=

# Puma (Heroku sets PORT; others have defaults)
# RAILS_MAX_THREADS=5
# DATABASE_POOL_SIZE=15
# WEB_CONCURRENCY=2

# Override database URL if needed (database.yml uses MANUAL_DATABASE_URL || DATABASE_URL)
# MANUAL_DATABASE_URL=
